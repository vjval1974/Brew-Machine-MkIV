{
  "name": "brew-machine-mkiv-rpi",
  "version": "1.0.0",
  "description": "Raspberry Pi 5 port of the Brew Machine MkIV brewing controller.",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "tsc -p tsconfig.web.json",
    "watch:server": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "watch:web": "tsc -p tsconfig.web.json --watch --preserveWatchOutput",
    "start": "node dist/index.js",
    "dev": "npm run build:web && tsx watch src/index.ts",
    "mock": "npm run build:web && cross-env MOCK_HARDWARE=1 tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test:safety": "cross-env MOCK_HARDWARE=1 tsx scripts/test-safety.ts",
    "clean": "rimraf dist web/js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "node-libgpiod": "^0.4.2",
    "i2c-bus": "^5.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "cross-env": "^7.0.3",
    "rimraf": "^5.0.10",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
