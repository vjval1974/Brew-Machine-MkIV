[Unit]
Description=Brew Machine MkIV kiosk (Chromium fullscreen)
After=graphical.target brew-machine.service
Requires=brew-machine.service

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
ExecStartPre=/usr/bin/sleep 5
ExecStart=/home/pi/Brew-Machine-MkIV/rpi/scripts/kiosk-start.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
